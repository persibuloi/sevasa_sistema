# Copiar a docker/.env y llenar — MISMOS valores que backend/.env y Vercel
DATABASE_URL=postgresql://postgres.PROYECTO:CLAVE@aws-1-us-east-2.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://PROYECTO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# Dominio desde el que se sirve el front (nginx) — obligatorio en producción
CORS_ORIGEN=http://localhost
PG_POOL_MAX=10
RATE_LIMIT=300

# Build del front (llaves públicas por diseño)
VITE_SUPABASE_URL=https://PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
